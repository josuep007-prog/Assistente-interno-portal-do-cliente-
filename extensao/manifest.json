{
  "manifest_version": 3,
  "name": "Control Onvio · ControlTax",
  "short_name": "Control Onvio",
  "version": "0.2.0",
  "description": "Fila única das solicitações do Portal do Cliente Onvio, com prazos, prescrição e alertas para analistas e gestores.",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "sidePanel",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://onvio.com.br/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Control Onvio",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://onvio.com.br/br-portal-do-cliente/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://onvio.com.br/br-portal-do-cliente/service-requesting/*"
      ],
      "js": [
        "core.js",
        "grade.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://onvio.com.br/staff/*"
      ],
      "js": [
        "docs-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://onvio.com.br/staff/*"
      ],
      "js": [
        "core.js",
        "docs-ponte.js"
      ],
      "run_at": "document_start"
    }
  ],
  "minimum_chrome_version": "114"
}
