{
  "manifest_version": 3,
  "name": "Control Onvio · ControlTax",
  "short_name": "Control Onvio",
  "version": "0.13.0",
  "description": "Página de trabalho por cima do Onvio Portal do Cliente: filas, dashboards em tempo real, alertas e lembretes para analistas e gestores.",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://onvio.com.br/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Control Onvio",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://onvio.com.br/br-portal-do-cliente/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://onvio.com.br/br-portal-do-cliente/service-requesting/*"
      ],
      "js": [
        "core.js",
        "grade.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://onvio.com.br/br-portal-do-cliente/*",
        "https://onvio.com.br/staff/*"
      ],
      "js": [
        "shell.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://onvio.com.br/br-portal-do-cliente/*"
      ],
      "js": [
        "acao-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "minimum_chrome_version": "114",
  "optional_host_permissions": [
    "https://*/*"
  ],
  "commands": {
    "alternar-painel": {
      "suggested_key": {
        "default": "Alt+Shift+O"
      },
      "description": "Abrir ou fechar o Control Onvio (leva ao Onvio se você estiver em outro site)"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "app/app.html",
        "logo.svg",
        "fonts/archivo-latin-600-normal.woff2",
        "fonts/ibm-plex-sans-latin-500-normal.woff2"
      ],
      "matches": [
        "https://onvio.com.br/*"
      ]
    }
  ]
}
